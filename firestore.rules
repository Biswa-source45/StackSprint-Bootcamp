rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: check if the requesting user is a signed-in admin ────────────
    // Admins are identified by having role == 'admin' in their users doc,
    // OR by not having a users doc at all (admin accounts created directly
    // in Firebase Auth without a Firestore record).
    function isAdmin() {
      return request.auth != null && (
        !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // ── Helper: is this the user's own document? ─────────────────────────────
    function isOwn(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ── users collection ──────────────────────────────────────────────────────
    match /users/{userId} {
      // Admin can read/write every user document (needed for student list)
      allow read, write: if isAdmin();

      // A student can only read/write their own document (session tracking)
      allow read, write: if isOwn(userId);
    }

    // ── courses collection ────────────────────────────────────────────────────
    match /courses/{courseId} {
      // Admin can do everything
      allow read, write, delete: if isAdmin();

      // Authenticated students can read courses (e.g. to show their course name)
      allow read: if request.auth != null;
    }

    // ── resources collection (video lectures / notes / projects) ─────────────
    match /resources/{resourceId} {
      // Any signed-in user (student or admin) can view the resource library
      allow read: if request.auth != null;

      // Only admin can add / edit / remove resources
      allow write, delete: if isAdmin();
    }

    // ── doubts collection (student query/support tickets) ────────────────────
    match /doubts/{doubtId} {
      // A student may create a doubt only under their own uid
      allow create: if isOwn(request.resource.data.studentId);

      // A student can read/update/delete their own doubt (e.g. confirm resolution,
      // reopen, or delete it); admin can read/update/delete any doubt
      allow read, update, delete: if isOwn(resource.data.studentId) || isAdmin();
    }

    // ── notifications collection (in-app alerts) ──────────────────────────────
    match /notifications/{notificationId} {
      // Owner or admin can read/mark-read/delete
      allow read, update, delete: if isOwn(resource.data.uid) || isAdmin();

      // Admin can notify anyone; a user may also write their own (e.g. self-service flows)
      allow create: if isAdmin() || isOwn(request.resource.data.uid);
    }

    // ── passwordResets collection (forgot-password OTPs) ──────────────────────
    // Written and read exclusively by the /api/request-otp and /api/reset-password
    // serverless functions via the Admin SDK, which bypasses these rules entirely —
    // this just guarantees no client (student, admin, or otherwise) can ever read
    // or forge an OTP hash directly through the normal Firestore client SDK.
    match /passwordResets/{email} {
      allow read, write: if false;
    }
  }
}
